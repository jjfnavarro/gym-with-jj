{
  "name": "gym-with-jj",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11 <25"
  },
  "dependencies": {
    "prisma": "7.10.1"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @gym/api\" \"npm run dev -w @gym/web\"",
    "build": "npm run db:generate && npm run typecheck && npm run build -w @gym/web && npm run build -w @gym/api",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/api && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "start": "node apps/api/dist/server.js",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "owner:create": "node --env-file-if-exists=.env apps/api/dist/owner.js",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "esbuild": "0.28.2",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "5.1.0"
  }
}
